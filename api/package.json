{
	"name": "basic-ai-chat-api",
	"version": "1.0.0",
	"description": "",
	"scripts": {
		"start": "tsx watch src/index.ts",
		"format": "prettier src/**/*.{ts,tsx,js,jsx,json,css,scss,html} --write",
		"compile": "tsc --noEmit",
		"test": "tsx --test --test-concurrency=1 src/test/*.test.ts",
		"db": "drizzle-kit",
		"db:push": "npm run db push",
		"db:dropTables": "npx tsx src/db/dropTables.ts",
		"db:migrate": "npm run db migrate",
		"db:generate": "npm run db generate",
		"db:studio": "npm run db studio",
		"seedDatabase": "bash ./src/scripts/setup.sh"
	},
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "24.13.1",
		"@types/pg": "8.20.0",
		"drizzle-kit": "0.31.10",
		"prettier": "3.8.3",
		"prettier-plugin-brace-style": "0.10.1",
		"prettier-plugin-merge": "0.10.1",
		"prettier-plugin-sort-imports": "1.8.11",
		"prettier-plugin-tailwindcss": "0.8.0",
		"tsx": "4.22.4",
		"typescript": "6.0.3"
	},
	"dependencies": {
		"@ai-sdk/google": "3.0.80",
		"@google/genai": "2.8.0",
		"@hono/node-server": "2.0.4",
		"@hono/zod-validator": "0.8.0",
		"ai": "6.0.198",
		"dotenv": "17.4.2",
		"drizzle-orm": "0.45.2",
		"hono": "4.12.24",
		"hono-rate-limiter": "0.5.3",
		"pg": "8.21.0",
		"zod": "4.4.3"
	}
}
